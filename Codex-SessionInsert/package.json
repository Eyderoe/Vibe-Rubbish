{
  "name": "codex-session-insert",
  "displayName": "Codex Session Insert",
  "description": "Insert Codex file references (standard line-number links or simplified [@file#line] style) into Codex with one shortcut",
  "publisher": "eyderoe",
  "version": "0.1.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eyderoe/Codex-SessionInsert"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexSessionInsert.insert"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex Session Insert",
      "properties": {
        "codexSessionInsert.copyToClipboard": {
          "type": "boolean",
          "default": false,
          "description": "插入 Codex 时是否同时复制引用到剪贴板"
        },
        "codexSessionInsert.referenceStyle": {
          "type": "string",
          "enum": [
            "standard",
            "simplified"
          ],
          "enumDescriptions": [
            "标准风格：Markdown 链接 [相对路径 (line 行号)](/绝对路径:行号)，多文件逗号分隔",
            "简化风格：0.1.3 格式 [@file] / [@file#行号]，多文件固定 separate 样式 [@a][@b]"
          ],
          "default": "standard",
          "description": "插入 Codex 的引用样式"
        }
      }
    },
    "commands": [
      {
        "command": "codexSessionInsert.insert",
        "title": "插入Codex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexSessionInsert.insert",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        }
      ],
      "explorer/context": [
        {
          "command": "codexSessionInsert.insert",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste",
          "multiSelect": true
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  }
}
